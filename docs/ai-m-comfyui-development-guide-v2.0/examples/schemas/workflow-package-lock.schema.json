{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-m.local/schemas/workflow-package-lock-v1.json",
  "title": "ai-m Workflow Package Lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workflowId",
    "version",
    "files",
    "environmentLockDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "workflowId": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "files": {
      "type": "object",
      "minProperties": 3,
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9._/-]+$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "environmentLockDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
