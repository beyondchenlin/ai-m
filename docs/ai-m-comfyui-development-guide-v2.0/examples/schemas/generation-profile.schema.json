{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-m.local/schemas/generation-profile-v1.json",
  "title": "ai-m Generation Profile Revision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "profileKey",
    "revision",
    "displayName",
    "capability",
    "adapterKind",
    "executionBackendId",
    "workflowPackageDigest",
    "defaults",
    "allowedOverrides",
    "outputPolicy",
    "retryPolicy"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]{3,128}$"
    },
    "profileKey": {
      "type": "string",
      "pattern": "^[a-z0-9-]{3,96}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "capability": {
      "enum": [
        "text",
        "image",
        "video",
        "speech",
        "utility"
      ]
    },
    "adapterKind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96
    },
    "executionBackendId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 3,
          "maxLength": 96
        },
        {
          "type": "null"
        }
      ]
    },
    "workflowPackageDigest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "defaults": {
      "type": "object"
    },
    "allowedOverrides": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "outputPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxItems",
        "maxBytes",
        "allowedMediaKinds"
      ],
      "properties": {
        "maxItems": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1024
        },
        "allowedMediaKinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "image",
              "video",
              "audio",
              "text",
              "archive"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "retryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connectRetries",
        "collectRetries",
        "commitRetries",
        "externalExecutionRetries"
      ],
      "properties": {
        "connectRetries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "collectRetries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "commitRetries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "externalExecutionRetries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        }
      }
    }
  }
}
