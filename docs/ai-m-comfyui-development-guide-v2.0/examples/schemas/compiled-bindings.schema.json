{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-m.local/schemas/compiled-bindings-v1.json",
  "title": "ai-m Compiled Bindings v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workflowId",
    "version",
    "workflowSha256",
    "authorContractSha256",
    "bindings",
    "outputs"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "workflowId": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "workflowSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "authorContractSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "nodeId",
          "classType",
          "inputName",
          "valueType",
          "required",
          "userOverride"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "nodeId": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "classType": {
            "type": "string"
          },
          "inputName": {
            "type": "string"
          },
          "valueType": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "userOverride": {
            "type": "boolean"
          },
          "default": {},
          "minimum": {
            "type": "number"
          },
          "maximum": {
            "type": "number"
          },
          "enum": {
            "type": "array"
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "nodeId",
          "classType",
          "field",
          "mediaKind",
          "maxItems"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "nodeId": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "classType": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "mediaKind": {
            "type": "string"
          },
          "maxItems": {
            "type": "integer"
          }
        }
      }
    }
  }
}
