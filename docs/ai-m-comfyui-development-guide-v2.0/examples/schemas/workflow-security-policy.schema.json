{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-m.local/schemas/workflow-security-policy-v1.json",
  "title": "ai-m Workflow Security Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyId",
    "version",
    "allowedNodeClasses",
    "deniedNodeClasses",
    "deniedInputNameTokens",
    "limits"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "policyId": {
      "type": "string",
      "pattern": "^[a-z0-9-]{3,96}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "allowedNodeClasses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "uniqueItems": true
    },
    "deniedNodeClasses": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "uniqueItems": true
    },
    "deniedInputNameTokens": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_-]{1,64}$"
      },
      "uniqueItems": true
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxNodes",
        "maxEdges",
        "maxBindings",
        "maxOutputs",
        "maxPromptChars",
        "maxPixels",
        "maxBatch",
        "maxOutputBytes",
        "maxPackageFiles",
        "maxExpandedBytes"
      ],
      "properties": {
        "maxNodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "maxEdges": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50000
        },
        "maxBindings": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "maxOutputs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "maxPromptChars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200000
        },
        "maxPixels": {
          "type": "integer",
          "minimum": 65536,
          "maximum": 268435456
        },
        "maxBatch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "maxOutputBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1099511627776
        },
        "maxPackageFiles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "maxExpandedBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1099511627776
        }
      }
    }
  }
}
