{
  "name": "ai-comic-builder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "preflight:runtime": "node scripts/runtime-preflight.mjs",
    "dev": "node scripts/runtime-preflight.mjs && next dev",
    "build": "node scripts/runtime-preflight.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node scripts/runtime-preflight.mjs && vitest run --exclude scripts/__tests__/runtime-preflight.test.mjs",
    "test:runtime": "node --test scripts/__tests__/runtime-preflight.test.mjs",
    "test:watch": "vitest",
    "test:regression": "vitest run src/lib/capability/__tests__/regression-baseline.test.ts",
    "test:validate-examples": "python tools/validate_examples.py",
    "worker:dev": "node scripts/runtime-preflight.mjs && tsx --env-file=.env src/worker/index.ts",
    "worker": "node dist/worker/index.cjs",
    "seed:visual-subjects": "npx tsx scripts/seed-visual-subjects.ts",
    "seed:zimage": "tsx scripts/seed-zimage-workflow.ts",
    "promote:zimage": "tsx scripts/promote-zimage-workflow.ts",
    "seed:zimage-quality": "tsx scripts/seed-zimage-quality-workflow.ts",
    "promote:zimage-quality": "tsx scripts/promote-zimage-quality-workflow.ts",
    "seed:local-speech": "tsx scripts/seed-local-speech-workflow.ts",
    "promote:local-speech": "tsx scripts/promote-local-speech.ts",
    "typecheck": "node scripts/runtime-preflight.mjs && tsc --noEmit",
    "worker:build": "node scripts/runtime-preflight.mjs && esbuild src/worker/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/worker/index.cjs --external:better-sqlite3 --external:sharp",
    "quality:static": "node scripts/runtime-preflight.mjs && corepack pnpm typecheck && corepack pnpm lint && corepack pnpm test && corepack pnpm test:runtime && corepack pnpm test:validate-examples && corepack pnpm test:migrations && corepack pnpm test:pr12-static && corepack pnpm test:pr13-static",
    "quality": "node scripts/runtime-preflight.mjs && corepack pnpm quality:static && corepack pnpm worker:build && corepack pnpm build",
    "test:migrations": "python tools/test_migrations.py",
    "test:pr12": "vitest run src/lib/security/__tests__ src/lib/generation/workflows/__tests__ src/lib/generation/archiving/__tests__ src/lib/generation/resources/__tests__ src/lib/generation/transports/__tests__ src/worker/__tests__",
    "workflow:import": "tsx scripts/import-workflow-package.ts",
    "workflow:promote": "tsx scripts/promote-workflow-package.ts",
    "test:pr12-static": "python -m unittest tools.test_pr12_static_checks && python tools/pr12_static_checks.py",
    "smoke:generation": "tsx scripts/smoke-generation-job.ts",
    "test:pr13": "vitest run src/stores/__tests__/model-store-migration.test.ts src/lib/generation/__tests__/speech-contract.test.ts src/lib/generation/__tests__/speech-domain.test.ts src/lib/generation/jobs/__tests__/idempotency.test.ts src/lib/generation/__tests__/artifact-selection.test.ts src/lib/security/__tests__/model-discovery-policy.test.ts src/lib/security/__tests__/pinned-json-request.test.ts src/lib/security/__tests__/request-origin.test.ts src/lib/security/__tests__/request-validation.test.ts",
    "test:pr13-static": "python -m unittest tools.test_pr13_static_checks && python tools/pr13_static_checks.py",
    "smoke:speech": "tsx scripts/smoke-speech-job.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.43",
    "@ai-sdk/openai": "^3.0.41",
    "@base-ui/react": "^1.2.0",
    "@google/genai": "^1.44.0",
    "@types/archiver": "^7.0.0",
    "ai": "^6.0.116",
    "archiver": "^7.0.1",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "fluent-ffmpeg": "^2.1.3",
    "lucide-react": "^0.577.0",
    "mammoth": "^1.12.0",
    "nanoid": "^5.1.7",
    "next": "16.1.6",
    "next-intl": "^4.8.3",
    "openai": "^6.27.0",
    "pdfjs-dist": "^5.5.207",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "shadcn": "^4.0.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "ulid": "^3.0.2",
    "undici": "^7.28.0",
    "unpdf": "^1.4.0",
    "zustand": "^5.0.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.9",
    "esbuild": "0.25.12",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.16.0 <23",
    "pnpm": ">=10.12.1 <11"
  }
}
